rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Forms collection
    match /forms/{formId} {
      allow read, write: if true;
      
      // Submissions sub-collection
      match /submissions/{subId} {
        allow read, write: if true;
      }
    }
    
    // Top-level submissions collection if accessed directly
    match /submissions/{subId} {
      allow read, write: if true;
    }

    // Default match
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
